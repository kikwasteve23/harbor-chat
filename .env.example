# Application
APP_URL=http://localhost:43147
APP_SECRET=change-me-to-a-long-random-string

# Storage: local JSON (dev) or Postgres (Render)
DATA_BACKEND=local
# DATA_BACKEND=postgres
DATABASE_URL=
# DATABASE_SSL=false

# Demo accounts created on first boot
DEMO_ADMIN_EMAIL=admin@harbor.local
DEMO_ADMIN_PASSWORD=admin-dev-only
DEMO_USER_EMAIL=demo@harbor.local
DEMO_USER_PASSWORD=demo-dev-only

# Optional Supabase (not required when using Render Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (optional — mock generator is used when empty)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
