# Application
APP_URL=http://localhost:43147
APP_SECRET=change-me-to-a-long-random-string
DATA_BACKEND=local
# DATA_BACKEND=supabase

# Demo / local-only accounts (development seed). Never use these in production.
DEMO_ADMIN_EMAIL=admin@harbor.local
DEMO_ADMIN_PASSWORD=admin-dev-only
DEMO_USER_EMAIL=demo@harbor.local
DEMO_USER_PASSWORD=demo-dev-only

# Supabase (required when DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (optional — mock grounded generator is used when empty)
AI_PROVIDER=mock
# AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
